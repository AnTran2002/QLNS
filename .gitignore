# ------------------------------------------------------------------
# Cấu hình kết nối & thông tin bảo mật — KHÔNG đưa lên GitHub.
# Chỉ commit các file mẫu (*.example*) để người khác sao chép.
# ------------------------------------------------------------------

# Back-End: thông tin kết nối CSDL, khoá bí mật (sao chép từ env.example.php)
Back-End/configs/env.php
Back-End/configs/*.local.php
Back-End/.env
Back-End/.env.*

# Front-End / mọi thư mục: biến môi trường Vite (sao chép từ .env.example)
.env
.env.*
!.env.example
!**/.env.example

# Khoá, chứng chỉ, file thông tin đăng nhập
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
secrets*.json
service-account*.json

# Cấu hình cá nhân của Claude Code / công cụ AI
.claude/settings.local.json
**/.claude/settings.local.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------
# File sinh ra theo từng máy — đưa lên sẽ làm hỏng việc chạy/test trên máy khác
# (Windows ⇄ macOS). Mỗi máy tự sinh lại bằng `npm install`.
# ------------------------------------------------------------------
# package-lock.json tạo trên macOS thiếu binding native của Windows (rolldown, lightningcss,
# @tailwindcss/oxide…) → máy kia báo "Cannot find module …" hoặc vite không khởi động.
package-lock.json
**/package-lock.json
yarn.lock
pnpm-lock.yaml
# Cache của Vite / Vitest, kết quả coverage
.vite/
**/node_modules/.vite/
coverage/
*.tsbuildinfo
# Rác hệ điều hành
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
._*
