# Backend PHP: php -S 127.0.0.1:8000 index.php (trong thư mục Back-End). Dùng 127.0.0.1 thay vì localhost
# vì PHP chỉ nghe IPv4, còn Node có thể phân giải localhost thành ::1 (IPv6) → lỗi 502.
BACKEND_URL=http://127.0.0.1:8000

# Đường dẫn API phía Front-End (Vite proxy sẽ chuyển /api sang backend)
VITE_API_BASE_URL=/api
