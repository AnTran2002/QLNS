# Sao chép file này thành .env (hoặc .env.local) rồi chỉnh theo máy của bạn (.env* không được commit).

# Địa chỉ backend PHP mà Vite proxy sẽ chuyển tiếp /api tới.
# Địa chỉ backend khi chạy PHP built-in server:
#   npm run backend (from Front-End)                  → http://localhost:8000
#   MAMP (htdocs/QLNS/Back-End)                    → http://127.0.0.1:8888/QLNS/Back-End
#   XAMPP (htdocs/QLNS/Back-End)                   → http://127.0.0.1/QLNS/Back-End
BACKEND_URL=http://localhost:8000

# Đường dẫn API mà trình duyệt gọi. Giữ /api để đi qua proxy (khuyên dùng).
# Nếu muốn gọi thẳng backend thì đặt URL đầy đủ, ví dụ http://localhost:8000
# (khi đó phải cấu hình FRONTEND_ORIGIN trong Back-End/configs/env.php cho CORS).
VITE_API_BASE_URL=/api
